root = true

[*]
indent_style = space
indent_size = 4
end_of_line = crlf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{json,yml,yaml,md,ps1}]
indent_size = 2

[*.cs]
dotnet_sort_system_directives_first = true
csharp_style_namespace_declarations = file_scoped:error
csharp_prefer_braces = true:warning
dotnet_diagnostic.CA1062.severity = none   # nullable covers it
dotnet_diagnostic.SA1101.severity = none   # no this. prefix
dotnet_diagnostic.SA1309.severity = none   # _field naming allowed
dotnet_diagnostic.SA1633.severity = none   # no file headers
